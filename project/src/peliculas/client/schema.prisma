generator client {
  provider = "prisma-client-js"
  output   = "../src/peliculas/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PELICULAS_URL")
}

model Pelicula {
  id         Int    @id @default(autoincrement())
  titulo     String
  director   String
  genero     String
  duracion   Int
  actores    String
  produccion String
}
